# Bash completion for iPShadowT
# Install: cp ipshadowt.bash-completion /etc/bash_completion.d/ipshadowt
# Or: source ipshadowt.bash-completion

_ipshadowt() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # Main options
    opts="-c --config -v --version -h --help --gen-reality-keys --test-transport --export-config"

    case "${prev}" in
        -c|--config)
            # Complete with .toml files
            COMPREPLY=( $(compgen -f -X '!*.toml' -- "${cur}") )
            COMPREPLY+=( $(compgen -d -- "${cur}") )
            return 0
            ;;
        --test-transport)
            # Expect IP:port
            return 0
            ;;
    esac

    if [[ "${cur}" == -* ]]; then
        COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
        return 0
    fi
}

complete -F _ipshadowt ipshadowt
complete -F _ipshadowt ./ipshadowt
